# Supabase project URL (not secret)
SUPABASE_URL=https://dcnosxpbkebgcktokzfa.supabase.co

# Supabase publishable/anon key — Project Settings -> API Keys -> publishable key.
# Tables have a public-read RLS policy, so this key can only read, never write.
SUPABASE_ANON_KEY=

# Supabase secret key — Project Settings -> API Keys -> secret key.
# Bypasses RLS. Only used server-side, in API routes that write data (e.g. workout upload).
SUPABASE_SECRET_KEY=
